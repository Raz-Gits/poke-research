# Copy this file to `.env` and fill in your eBay Production keys.
# `.env` is gitignored — your keys never get committed.
#
# Get these from https://developer.ebay.com -> My Account -> Application Keysets
# Create a PRODUCTION keyset (not Sandbox). The Browse API uses OAuth client
# credentials built from these two values.

EBAY_APP_ID=your-app-id-client-id-here
EBAY_CERT_ID=your-cert-id-client-secret-here

# (Marketplace is currently fixed to EBAY_US in collectors/ebay.py.)
